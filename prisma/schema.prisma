// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("Viewer") // Super Admin, Editor, Marketing, Viewer
  // Five wrong passwords in a row lock the account for 15 minutes
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  logs          ActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Page {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  status           String    @default("Draft") // Draft, Scheduled, Published
  publishDate      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // SEO
  metaTitle        String?
  metaKeywords     String?
  metaDescription  String?
  canonicalUrl     String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  structuredData   String? // JSON string
  robots           String? // index, follow
  
  sections         Section[]
}

model Section {
  id           String   @id @default(cuid())
  pageId       String
  type         String   // e.g. "HeroVideo", "GallerySection"
  order        Int
  isHidden     Boolean  @default(false)
  data         String   // JSON string of properties
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  authorId        String?
  coverImage      String?
  coverAlt        String?
  excerpt         String?   @db.Text        // Increased to TEXT
  body            String?   @db.LongText    // Increased to LONGTEXT for large blog content
  status          String    @default("Draft") // Draft, Scheduled, Published
  publishDate     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // SEO
  metaTitle       String?
  metaKeywords    String?   @db.Text
  metaDescription String?   @db.Text
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?   @db.Text
  ogImage         String?
  structuredData  String?   @db.LongText    // For large JSON-LD blocks
  robots          String?

  categories      PostCategory[]
  tags            PostTag[]
  sections BlogSection[]

  // Where the celebration took place; links the post to its destination page
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  // Set when moved to the trash; emptied for good after 30 days
  deletedAt       DateTime?
  revisions       PostRevision[]

  @@index([destinationId])
}

model BlogSection {
  id         String   @id @default(cuid())
  blogId     String
  section    String
  content    Json
  sortOrder  Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  blog       BlogPost @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([section])
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  posts       PostCategory[]
}

model PostCategory {
  postId     String
  categoryId String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([postId, categoryId])
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  posts       PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([postId, tagId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  details     String?  // JSON string
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String?  @db.Text // VARCHAR(191) rejected longer inquiries
  sourcePage  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      String   @default("New") // New, Contacted, Qualified, Closed, Spam
  assignedTo  String?
  notes       String?  @db.Text
  followUpAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalSettings {
  id                 String   @id @default("global")
  defaultMetaTitle   String?
  defaultMetaKeywords   String?
  defaultMetaDesc    String?
  defaultOgImage     String?
  gaId               String?
  gtmId              String?
  metaPixelId        String?
  linkedinInsightTag String?
  robotsTxt          String?  @db.Text

  // Contact page and the floating WhatsApp button
  whatsappNumber       String?
  whatsappMessage      String?  @db.Text
  whatsappEventMessage String?  @db.Text
  contactAddress       String?  @db.Text
  mapUrl               String?  @db.Text
  showMap              Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  permanent   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per click on the floating WhatsApp button; chats never reach the Leads inbox
model WhatsAppClick {
  id        String   @id @default(cuid())
  page      String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Short admin-managed lists shown on the public site (stats, FAQs, Instagram tiles, saved
// authors). `kind` picks the list; `data` holds that kind's fields (see src/lib/content-kinds.ts)
model ContentItem {
  id        String   @id @default(cuid())
  kind      String
  data      Json
  sortOrder Int      @default(0)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, sortOrder])
}

// A saved version of a post (fields + sections), kept on every manual save so edits can be undone
model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  snapshot  Json
  label     String?
  userId    String?
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// Destination guide pages (/destinations/<slug>)
model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  region          String?
  tagline         String?
  heroImage       String?
  intro           String?  @db.Text
  bestSeason      String?
  highlights      String?  @db.Text // one per line
  venues          String?  @db.Text // one per line
  metaTitle       String?
  metaDescription String?  @db.Text
  sortOrder       Int      @default(0)
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts BlogPost[]
}

// Albums on the Galleries page; until any exist the page uses the built-in albums
model Gallery {
  id         String   @id @default(cuid())
  slug       String   @unique
  heading    String
  subheading String?
  coverImage String
  sortOrder  Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos GalleryPhoto[]
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  galleryId String
  src       String  @db.VarChar(512)
  width     Int
  height    Int
  alt       String?
  sortOrder Int     @default(0)

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
}

// Description (alt text) for an image in the media library, keyed by its address
model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique @db.VarChar(512)
  alt       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
