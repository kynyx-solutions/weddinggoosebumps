{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare-worker.ts",
  "name": "wedding-goosebumps-beta",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wedding-goosebumps-beta"
    }
  ],
  "images": {
    // Next.js image optimization through Cloudflare Images
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
